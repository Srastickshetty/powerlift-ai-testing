# @powerlift/api Environment Configuration
NODE_ENV=production
PORT=5001

# PostgreSQL Database (Neon / Supabase / AWS RDS / Docker)
# Tip: Append ?connection_limit=20&pool_timeout=10 for high concurrency pooling
DATABASE_URL=postgresql://user:password@hostname:5432/powerlift_prod?connection_limit=20&pool_timeout=10

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://powerlift.ai,https://powerlift-ai-frontend.vercel.app

# Firebase Admin Service Account (for token verification)
FIREBASE_PROJECT_ID=powerlift-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@powerlift-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI Inference Keys (Optional / Fallback)
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Sentry DSN (Optional / Monitoring)
SENTRY_DSN=
