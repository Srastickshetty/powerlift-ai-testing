{
  "name": "@powerlift/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "prebuild": "npm run build --workspace=@powerlift/shared && npm run build --workspace=@powerlift/engines",
    "build": "tsc",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build --workspace=@powerlift/shared && npm run build --workspace=@powerlift/engines",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@powerlift/engines": "*",
    "@powerlift/shared": "*",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.1.0",
    "helmet": "^7.1.0",
    "pino": "^9.1.2",
    "pino-pretty": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/node": "^20.12.12",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "typescript": "^5.4.0"
  }
}
