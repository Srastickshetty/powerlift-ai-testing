{
  "name": "powerlift-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@powerlift/web",
    "dev:api": "npm run dev --workspace=@powerlift/api",
    "build:shared": "npm run build --workspace=@powerlift/shared",
    "build:engines": "npm run build --workspace=@powerlift/engines",
    "build:packages": "npm run build:shared && npm run build:engines",
    "build:api": "npm run build:packages && npm run build --workspace=@powerlift/api",
    "build:web": "npm run build --workspace=@powerlift/web",
    "build": "npm run build:packages && npm run build:api && npm run build:web",
    "typecheck:shared": "npm run typecheck --workspace=@powerlift/shared",
    "typecheck:engines": "npm run typecheck --workspace=@powerlift/engines",
    "typecheck:api": "npm run build:packages && npm run typecheck --workspace=@powerlift/api",
    "typecheck": "npm run build:packages && npm run typecheck:shared && npm run typecheck:engines && npm run typecheck:api",
    "lint": "npm run lint --workspace=@powerlift/web",
    "test:engines": "node packages/engines/src/engines.test.js",
    "test:api": "node apps/api/test/api.test.js",
    "test:migration": "npx tsx --test apps/api/test/migration.test.js",
    "test:p0": "node backend/test/p0_security.test.js",
    "test:p2": "node --test apps/api/test/p2_athlete_loop.test.js",
    "test:p3": "node --test apps/api/test/p3_dual_tracks.test.js",
    "test:p4": "node --test apps/api/test/p4_coach_payments.test.js",
    "test:p5": "node --test apps/api/test/p5_ai_engine.test.js",
    "test:p7": "node --test apps/api/test/p7_trust_compliance.test.js",
    "test:p8": "node --test apps/api/test/p8_e2e_flows.test.js",
    "eval": "npx tsx eval/harness.ts",
    "test": "npm run test:engines && npm run test:api && npm run test:migration && npm run test:p2 && npm run test:p3 && npm run test:p4 && npm run test:p5 && npm run test:p7 && npm run test:p8 && npm run eval",
    "prisma:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:validate": "npx prisma validate --schema=apps/api/prisma/schema.prisma",
    "prisma:seed": "node apps/api/prisma/seed.js",
    "db:fresh-start": "node scripts/fresh_start_reset.js",
    "migrate:data": "npx tsx scripts/migrate_firestore_to_postgres.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "5.22.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/node": "^20.12.12",
    "prisma": "5.22.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/node": "^20.12.12"
  }
}
